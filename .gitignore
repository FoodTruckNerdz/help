# Allow-list gitignore: everything is ignored unless explicitly un-ignored.
# When adding a new root file or directory, add a `!` entry here.

*
!*/

# Tracked root files and directories
!/.editorconfig
!/.gitattributes
!/.github/**
!/.gitignore
!/.vscode/**
!/astro.config.mjs
!/docs/**
!/dprint.jsonc
!/package.json
!/public/**
!/README.md
!/src/**
!/tsconfig.json

# Re-ignore generated and local files inside allowed directories
dist/
.astro/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.production
.DS_Store
